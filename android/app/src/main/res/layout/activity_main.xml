<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/bridge_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/subtitle"
            android:textColor="@color/bridge_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pairing_intro"
                android:textColor="@color/bridge_text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/originInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="@string/origin_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/maxPowerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="@string/max_power_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:singleLine="true" />

            <Button
                android:id="@+id/saveConfigButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/save_connection"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/copyPairingButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/copy_pairing"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/rotatePairingButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/rotate_pairing"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <TextView
                android:id="@+id/protocolBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protocol_badge"
                android:textColor="@color/bridge_success"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/status_checking"
                android:textColor="@color/bridge_text"
                android:textSize="17sp" />

            <Button
                android:id="@+id/bridgeButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/bridge_success"
                android:text="@string/start_bridge"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <TextView
                android:id="@+id/powerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/power_initial"
                android:textColor="@color/bridge_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/powerSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/bridge_text"
                android:text="@string/stop"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/safety_note"
                android:textColor="@color/bridge_warning"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/log_title"
                    android:textColor="@color/bridge_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/clearLogButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/bridge_surface"
                    android:text="@string/clear_log"
                    android:textAllCaps="false"
                    android:textColor="@color/bridge_primary_dark" />
            </LinearLayout>

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:minHeight="120dp"
                android:textColor="@color/bridge_muted"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
